# =============================================================================
# CONFIGURACION DE PROVEEDOR DE API VEHICULAR & SINCRONIZACION AUTOMATIZADA
# Albarracin Motos y Repuestos - Chabas, Santa Fe
# =============================================================================

# 1. Modo de Consulta Vehicular: Base Interna con Precarga y Busqueda Inmediata
VEHICLE_LOOKUP_PROVIDER=INTERNAL_CACHE

# 2. Conector Oficial DNRPA Directo (Desactivado para operar sin IP fija / sin convenio)
DNRPA_ENABLED=false
DNRPA_CONNECTION_TYPE=REST_API

# 3. Sincronizacion Automatica por Datos Abiertos (datos.gob.ar / ACARA)
OPEN_DATA_SYNC=true
DNRPA_SYNC_ENABLED=true
DNRPA_SYNC_SCHEDULE=30 3 * * *
DNRPA_SYNC_TIMEZONE=America/Argentina/Buenos_Aires

# 4. Mercado Libre
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REDIRECT_URI=https://albarracin-motos-repuestos.com.ar/api/mercadolibre/callback

# 5. Instagram Smart Catalog (Meta Graph API)
INSTAGRAM_ENABLED=true
INSTAGRAM_ACCOUNT_USERNAME=albarracinmotos
INSTAGRAM_USER_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_SYNC_SCHEDULE=30 3 * * *
INSTAGRAM_SYNC_TIMEZONE=America/Argentina/Buenos_Aires
