# =============================================================================
# CONFIGURACIÓN DE PROVEEDOR DE API VEHICULAR POR PATENTE & SINCRONIZACIÓN
# Albarracín Motos y Repuestos - Chabás, Santa Fe
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CONEXIÓN INSTITUCIONAL OFICIAL CON DNRPA (Argentina)
# -----------------------------------------------------------------------------
# Requiere convenio institucional previo, IP pública fija autorizada en firewall
# y credenciales / certificados mTLS otorgados por el organismo.
DNRPA_ENABLED=false
DNRPA_CONNECTION_TYPE=REST_API       # Opciones: REST_API, SOAP_WS, SECURE_FEED
DNRPA_API_URL=https://servicios.dnrpa.gov.ar/api
DNRPA_CLIENT_ID=
DNRPA_CLIENT_SECRET=
DNRPA_USERNAME=
DNRPA_PASSWORD=
DNRPA_CERTIFICATE_PATH=              # Ruta local a certificado .pem / .crt si aplica mTLS
DNRPA_TIMEOUT_SECONDS=15
DNRPA_SYNC_ENABLED=true
DNRPA_SYNC_SCHEDULE=30 3 * * *       # Cron: 03:30 AM
DNRPA_SYNC_TIMEZONE=America/Argentina/Buenos_Aires

# -----------------------------------------------------------------------------
# 2. PROVEEDOR COMERCIAL DE CONSULTA VEHICULAR (Alternativa sin convenio DNRPA)
# -----------------------------------------------------------------------------
# Opciones para VEHICLE_LOOKUP_PROVIDER:
# - 'INTERNAL_CACHE' : Base interna relacional persistente (Modo Autónomo 100% offline)
# - 'COMMERCIAL_API' : Proveedor comercial de API vehicular (DataCar, InfoAuto, AutoScore, etc.)
# - 'DNRPA_PROVIDER' : Conector directo oficial DNRPA configurado arriba
VEHICLE_LOOKUP_PROVIDER=INTERNAL_CACHE
VEHICLE_LOOKUP_API_URL=https://api.vehicular.com.ar/v1/lookup
VEHICLE_LOOKUP_API_KEY=tu_token_aqui

# -----------------------------------------------------------------------------
# 3. MERCADO LIBRE OFICIAL
# -----------------------------------------------------------------------------
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REDIRECT_URI=https://albarracin-motos-repuestos.com.ar/api/mercadolibre/callback

